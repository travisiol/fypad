# Copy to .env.local for local runs. Never commit real keys.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=
# $FYP mint: until set, the platform fee share is held (shown as held), not spent.
NEXT_PUBLIC_MINT=
OPERATOR_SECRET_KEY=
LAUNCH_WEBHOOK=
LAUNCH_SECRET=
# TICK_SECRET = CRON_SECRET (Vercel cron sends Bearer CRON_SECRET)
TICK_SECRET=
CRON_SECRET=
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3954
NEXT_PUBLIC_X_HANDLE=

# Video provider: higgsfield (default) or openai (Sora)
VIDEO_PROVIDER=higgsfield
# Higgsfield API key id + secret (or HIGGSFIELD_API_KEY="KEY_ID:KEY_SECRET")
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_VIDEO_MODEL=bytedance/seedance-2.0/text-to-video
HIGGSFIELD_RESOLUTION=720p
# What one video debits from a coin's content budget
COST_PER_VIDEO_SOL=0.05

# Optional: scene + caption writer (json_schema). Without it the scene is built from the coin's own setup.
# Also the key for VIDEO_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VIDEO_MODEL=sora-2

# TikTok Content Posting API (Direct Post). Redirect URI to register: <NEXT_PUBLIC_SITE_URL>/api/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 32+ random characters; encrypts TikTok tokens at rest (AES-256-GCM)
TOKEN_ENCRYPTION_SECRET=
# Optional: PUBLIC_TO_EVERYONE once the app is audited (default: most private level offered)
TIKTOK_PRIVACY_LEVEL=

JUPITER_API_URL=https://lite-api.jup.ag
FYPAD_DB_PATH=./data/fypad.db
FYPAD_VIDEO_DIR=./data/videos

# Tests and the local rig only: HIGGSFIELD_BASE_URL, TIKTOK_API_URL, TIKTOK_AUTHORIZE_URL, OPENAI_BASE_URL
